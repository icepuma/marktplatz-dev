---
// An 8x8 pixel gold coin, drawn from a character grid.
type Props = { size?: number; class?: string };
const { size = 24, class: className } = Astro.props;
const grid = [
  "..####..",
  ".#yyyy#.",
  "#yywwyy#",
  "#ywyyoy#",
  "#yyyyoy#",
  "#yyooyy#",
  ".#yyyy#.",
  "..####..",
];
const colors: Record<string, string> = { "#": "#5a3a22", y: "#e2b04a", w: "#fff4c2", o: "#b07a1e" };
const pixels = grid.flatMap((row, y) => [...row].map((c, x) => ({ x, y, fill: colors[c] })).filter((p) => p.fill));
---

<svg class:list={["pixel", className]} width={size} height={size} viewBox="0 0 8 8" aria-hidden="true">
  {pixels.map((p) => <rect x={p.x} y={p.y} width="1" height="1" fill={p.fill} />)}
</svg>
