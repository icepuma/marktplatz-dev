---
import Builder from "@/components/Builder";
import PageHead from "@/components/PageHead.astro";
import Layout from "@/layouts/Layout.astro";
import { loadCatalog } from "@/lib/catalog";
import { buildSha, REPO_URL } from "@/lib/site";

const catalog = await loadCatalog();
const ctx = { repoUrl: REPO_URL, sha: buildSha() };
---

<Layout title="marktplatz" hero>
  <div class="stack stack-lg">
    <PageHead title="Hear ye! The skill market is open.">
      <p class="lede">
        Pick whole guilds or single skills for thy agent and take them home to Claude Code or Codex in one marketplace
        file. Every skill carries a charter and was cleared by <a href="/watch">all three watchmen</a> at the gate.
      </p>
      <ol class="how" aria-label="How it works">
        <li>Pick guilds or skills</li>
        <li>Download the file for thy harness</li>
        <li>Run the commands shown</li>
      </ol>
    </PageHead>
    <Builder client:load catalog={catalog} ctx={ctx} />
  </div>
</Layout>
