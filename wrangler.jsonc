{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "marktplatz-dev",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  // Every uploaded version also gets its own URL.
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Worker Previews: one isolated Preview per pull request (see .github/workflows/preview.yml).
  "previews": {}
}
